# Rocket Launch Tracker - environment variables
# Copy this file to .env and fill in your values.
# Do not commit .env.

# NASA API key (optional)
# Get a free key: https://api.nasa.gov/#signUp
# Empty values and placeholders are ignored. The app then uses DEMO_KEY
# (30 requests/hour). A personal key allows 1,000 requests/hour.
# For App Store builds, set this with `eas env:create` instead of committing it.
# See APP_STORE_RELEASE.md. Do not put the key in app.json.
EXPO_PUBLIC_NASA_API_KEY=

# Launch Library 2
# dev  - https://lldev.thespacedevs.com/2.3.0 (use this while developing)
# prod - https://ll.thespacedevs.com/2.3.0 (free tier is about 15 requests/hour per IP)
# Preview and production EAS profiles set prod in eas.json.
# If this is unset, debug builds use dev and release builds use prod.
EXPO_PUBLIC_LL2_ENV=dev

# Rocket Launch Tracker - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# NASA API Key (Optional but recommended)
# Get your free API key from: https://api.nasa.gov/#signUp
# Without a key, the app will use DEMO_KEY (limited to 30 requests/hour)
# With your own key, you get 1,000 requests/hour
EXPO_PUBLIC_NASA_API_KEY=<YOUR_NASA_API_KEY_HERE>

# Launch Library 2 API Environment
# Options: 'dev' or 'prod'
# 'dev' uses https://lldev.thespacedevs.com (no API key required, lower rate limits)
# 'prod' uses https://ll.thespacedevs.com (may require API key for higher limits)
EXPO_PUBLIC_LL2_ENV=dev
